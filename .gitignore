node_modules/
dist/
*.local
.DS_Store
.vite/
*.tsbuildinfo

# Manual and scripted backup copies of the workbook, however they are named
# (hiv_curation.backup-..., hiv_curation-backup20sept2026.xlsx). Local only: git is the
# version history once hiv_curation.xlsx itself is committed.
hiv_curation*backup*.xlsx
hiv_curation-original*.xlsx

# The single-file review copy is a build artefact, regenerated on demand.
HIV-dashboard-review.html

# ---------------------------------------------------------------------------
# hiv_curation.xlsx IS committed, deliberately.
#
# It is the source of truth, and the deploy workflow regenerates
# hiv_dashboard_data.json from it on every push. That means a validation error
# fails the build instead of reaching the site, and the workbook and the
# published data can never drift apart.
#
# Note this makes the curator_notes and exclude_reason columns public along
# with everything else. Keep genuinely private working notes elsewhere.
# ---------------------------------------------------------------------------
